{
  "name": "colony-ship",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "depcheck": "depcruise src --config .dependency-cruiser.cjs",
    "ci": "npm run typecheck && npm run lint && npm run depcheck && npm test && npm run build",
    "dev:raw": "vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "bitecs": "0.4.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
